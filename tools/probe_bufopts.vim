" Writes the table of crates/rim/src/editor/script/bufopts.table: the buffer-local options of Neovim with the values a
" fresh buffer has, one `name=value` per line (the value as `string()` writes it).
"   nvim --headless -u NONE -i NONE -n -es -c 'source tools/probe_bufopts.vim' -c 'qa!'
let d = getbufvar(1, '&')
let lines = ['" Generated by tools/probe_bufopts.vim from ' . substitute(execute('version'), '^\n*\(NVIM[^\n]*\).*', '\1', '') . '; do not edit.']
for k in sort(keys(d))
  call add(lines, k . '=' . string(d[k]))
endfor
call writefile(lines, 'crates/rim/src/editor/script/bufopts.table')
